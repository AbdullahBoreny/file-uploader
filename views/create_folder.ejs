<link rel="stylesheet" href="/create_folders.css">


<body>
    <h1 class="name">
        Hello
        <%= user.name %>!
    </h1>
    <div class="container">

        <div class="message">
            <%- include("partials/create_message_err.ejs") %>

                <% if (typeof message !=="undefined" ) { %>
                    <div class="sucessDelete">
                        <%= message %>
                    </div>
                    <% } %>
        </div>

        <form method="POST" action="/upload/folder">
            <label for="folder">Create Folder:</label><br><br>
            <input name="folder" type="text" placeholder="Folder name">
            <input type="submit" value="Create">
        </form>

        <ul>
            <% if (typeof folders !=="undefined" && folders.length> 0) { %>

                <% folders.forEach(function(folder) { %>
                    <li>
                        <a class="folder-link" href="/upload/folder/<%= folder.id %>">
                            📁 <%= folder.name %>
                        </a>

                        <div class="actions">
                            <form action="/upload/<%= folder.id %>/folder/delete" method="POST"
                                onsubmit="return confirm('Are you sure you want to delete this folder?');">
                                <button type="submit">Delete</button>
                            </form>
                        </div>
                    </li>
                    <% }) %>

                        <% } else { %>
                            <li>No folders yet</li>
                            <% } %>
        </ul>
    </div>
    <a href="/">go back</a>
</body>

</html>