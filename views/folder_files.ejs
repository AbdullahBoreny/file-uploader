<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="/upload_files.css">
</head>
<body>
    <div class="folder_files">
        <% if (typeof folder !=='undefined' ) { %>
            <h1>📁 Folder: <%= folder.name %>
            </h1>

            <ul class="files_container">
                <% if (folder.files.length> 0) { %>
                    <% folder.files.forEach(function(file) { %>
                        <li>
                            <div class="file">
                                <img height="50px" width="50px" src="/upload/file/<%=file.id%>/download">

                                <div>
                                    <div><strong>
                                            <%= file.name %>
                                        </strong></div>

                                    <div class="meta">
                                        Created: <%= file.createdAt.toLocaleString() %>
                                    </div>

                                    <form method="GET" action="/upload/file/<%= file.id %>/link">
                                        <button type="submit">Share Link (2 min)</button>
                                    </form>

                                    <a href="/upload/file/<%=file.id%>/download" download="<%= file.name %>">
                                        Download
                                    </a>
                                </div>
                            </div>
                        </li>
                        <% }) %>
                            <% } else { %>
                                <li>No files yet</li>
                                <% } %>
            </ul>

            <div class="upload-box">
                <form method="POST" action="/upload/folder/<%= folder.id %>" enctype="multipart/form-data">
                    <input id="avatar" name="avatar" type="file">
                    <br>
                    <input type="submit" value="Add File">
                </form>
            </div>

            <a class="back" href="/upload/folder">⬅ Back</a>
            <% } %>
    </div>


</body>

</html>